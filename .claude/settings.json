{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "Bash(git *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(curl *)",
      "Bash(uvicorn *)",
      "Bash(pytest *)",
      "Bash(python -m *)",
      "Bash(python3 -m *)",
      "Bash(ruff *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx playwright *)",
      "Bash(taskkill //PID *)",
      "Bash(where *)",
      "Bash(choco *)",
      "Bash(winget *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(uvicorn backend.main:app *)",
      "Bash(python scripts/*)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(.venv/Scripts/python *)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/python3 *)",
      "Bash(svn info *)",
      "Bash(svn ls *)",
      "Bash(svn log *)",
      "Bash(svn diff *)",
      "Bash(svn status *)",
      "Bash(svn checkout *)",
      "Bash(schtasks //query *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(jq *)",
      "Bash(tasklist *)",
      "Bash(netstat *)",
      "Bash(type *)",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "Monitor",
      "mcp__devops-release__*",
      "mcp__playwright__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --force-with-lease)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .env ] || ([ -f .env.example ] && cp .env.example .env && echo '{\"systemMessage\":\".env created from .env.example\"}') || true",
            "timeout": 5,
            "statusMessage": "Checking .env..."
          },
          {
            "type": "command",
            "command": "[ \"$(git config core.hooksPath 2>/dev/null)\" = \".githooks\" ] || ([ -f scripts/install_git_hooks.sh ] && bash scripts/install_git_hooks.sh >/dev/null 2>&1 && echo '{\"systemMessage\":\"git hooks activated via scripts/install_git_hooks.sh\"}') || true",
            "timeout": 10,
            "statusMessage": "Checking git hooks..."
          },
          {
            "type": "command",
            "command": "echo '{\"systemMessage\":\"reminder: settings/hooks 변경 시 .bak 백업 + python -c json.load() parse 검증 의무 (.claude/rules/autonomous-operation.md 참조)\"}'",
            "timeout": 2,
            "statusMessage": "Policy reminder..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/posttool_dispatch.py 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Quality dispatcher (syntax/lint/test/md)..."
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/posttoolbatch_report.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Batch report (X1~X9 trigger)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json,re; d=json.load(sys.stdin); f=d.get('tool_input',{}).get('file_path',''); warn=''; exts=('.c','.h'); do_check=any(f.endswith(e) for e in exts); content=open(f,'r',encoding='utf-8',errors='ignore').read() if do_check and __import__('os').path.isfile(f) else ''; asil=re.search(r'@asil\\s+(C|D)',content,re.IGNORECASE) if content else None; warn=f'WARNING: ASIL {asil.group(1)} file — reviewer approval required before modifying: {f}' if asil else ''; print(json.dumps({'hookSpecificOutput':{'hookEventName':'PreToolUse','additionalContext':warn}})) if warn else None\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "ASIL safety check..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/quality_check.py 2>/dev/null || true",
            "timeout": 180,
            "statusMessage": "Quality check (tests + lint + patterns)..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json,subprocess,os; status=subprocess.run(['git','status','--porcelain'],capture_output=True,text=True).stdout[:500]; diff_stat=subprocess.run(['git','diff','--stat'],capture_output=True,text=True).stdout[:500]; os.makedirs('.codex_tmp',exist_ok=True); open('.codex_tmp/precompact_context.json','w').write(json.dumps({'git_status':status,'git_diff_stat':diff_stat},ensure_ascii=False)); print(json.dumps({'systemMessage':'PreCompact: preserved git status + diff stat to .codex_tmp/precompact_context.json. Changed: '+status[:150]}))\" 2>/dev/null || echo '{\"systemMessage\":\"PreCompact: preserve task progress, file paths, error context, test results, MCP patterns\"}'",
            "statusMessage": "Preserving context to file..."
          }
        ]
      }
    ]
  },
  "env": {
    "PYTHONPATH": ".",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUTF8": "1",
    "NODE_ENV": "development"
  },
  "enableAllProjectMcpServers": true,
  "extraKnownMarketplaces": {
    "devops-release-local": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins/devops-release"
      },
      "autoUpdate": false
    }
  },
  "enabledPlugins": {
    "devops-release@devops-release-local": true
  },
  "language": "korean"
}
