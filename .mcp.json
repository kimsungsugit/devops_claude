{
  "mcpServers": {
    "devops-release": {
      "command": "${CLAUDE_PROJECT_DIR:-.}/.venv/Scripts/python.exe",
      "args": ["-m", "backend.mcp.stdio_server"],
      "cwd": "${CLAUDE_PROJECT_DIR:-.}",
      "env": {
        "PYTHONPATH": "${CLAUDE_PROJECT_DIR:-.}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headed"]
    }
  }
}
