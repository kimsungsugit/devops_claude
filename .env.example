# =============================================================================
# DevOps Analysis Toolkit - Environment Variables
# Copy this file to .env and customize values for your environment.
# =============================================================================

# --- Project Root ---
# DEVOPS_PROJECT_ROOT=/app/my_lin_gateway

# --- Jenkins Integration ---
DEVOPS_JENKINS_BASE_URL=http://localhost:8080
DEVOPS_JENKINS_USERNAME=admin
DEVOPS_JENKINS_API_TOKEN=your-api-token-here
DEVOPS_JENKINS_HIDE_CREDENTIALS=1
DEVOPS_JENKINS_VERIFY_TLS=1
DEVOPS_JENKINS_LOG_SCAN_LIMIT=6
# DEVOPS_JENKINS_SERVER_ROOTS=C:/ProgramData/Jenkins/.jenkins

# --- SCM (Subversion) Credentials ---
# Global fallback password for `svn checkout` during Jenkins artifact sync.
# Per-registry override: set `scm_password_env` on each entry in
# config/scm_registry.json (e.g. scm_password_env=SVN_PWD_HDPDM01) and define
# that variable here. Plaintext passwords are NEVER accepted via HTTP body.
# On developer machines with a cached SVN auth, this can be left blank.
#
# Resolution order (see backend/services/scm_registry.py: resolve_scm_credentials):
#   1. Request `scm_id` or `repo_url` → matching registry entry.
#   2. Username: explicit override > entry.scm_username.
#   3. Password: env[entry.scm_password_env] > env[DEVOPS_SCM_PASSWORD].
# Note: if `scm_password_env` is set on an entry but the named variable is
#   empty at runtime, we fall through to DEVOPS_SCM_PASSWORD — so keep shared
#   fallback out of the env unless that behaviour is desired, or clear the
#   entry's scm_password_env to opt out of the fallback.
# Validation: env-var names must match [A-Z_][A-Z0-9_]{0,63} and cannot be
#   well-known system variables (PATH, HOME, etc).
# DEVOPS_SCM_PASSWORD=
# SVN_PWD_HDPDM01=

# --- LLM / AI Configuration ---
# Google API key (used by OAI_CONFIG_LIST when api_key="ENV:GOOGLE_API_KEY")
GOOGLE_API_KEY=your-google-api-key-here
# Path to OAI_CONFIG_LIST JSON file
# DEVOPS_OAI_CONFIG_PATH=/app/OAI_CONFIG_LIST
# Force Gemini-only mode (1=yes, 0=no)
LLM_GEMINI_ONLY=1
LLM_GEMINI_PREFERRED_SUBSTRING=gemini-3.5-flash-lite
# 단일 모델 하드락(선택) — 주석 해제 시 모든 LLM 호출을 이 모델로 강제한다.
# LLM_MODEL_OVERRIDE=gemini-3.5-flash-lite
LLM_READ_TIMEOUT=300
LLM_MAX_INPUT_TOKENS=1000000
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- RAG / Knowledge Base ---
# Storage backend: sqlite or pgvector
KB_STORAGE=sqlite
# PGVECTOR_DSN=postgresql://user:pass@localhost:5432/devops_kb
# PGVECTOR_URL=postgresql://user:pass@localhost:5432/devops_kb
# KB_GLOBAL_DIR=C:/Users/username/.devops_kb
# KB_SOURCES_DIR=
FORCE_PGVECTOR=0

# --- External Document Paths (comma-separated) ---
# VC_REPORTS_PATHS=
# UDS_SPEC_PATHS=
# REQ_DOCS_PATHS=
# CODEBASE_PATHS=

# --- UDS Generation ---
# Server-side default UDS docx template (used when frontend omits template_path).
# Points to the tokenized template — 1.1~1.4 filled from payload.
# UDS_TEMPLATE_PATH=docs/(HDPDM01_SUDS)_template_tokenized.docx
# Reference docx used for swcom-context diff report.
# UDS_REF_SUDS_PATH=docs/(HDPDM01_SUDS) Software Unit Design Specification_v1.07_240213.docx

# --- Build & Test ---
# AUTO_INSTALL_GCOVR=1
# TEST_GEN_TIMEOUT_SEC=60

# --- Claude Code harness env vars ---
BACKEND_URL=http://127.0.0.1:9000
BACKEND_PORT=9000
FRONTEND_PORT=5174
PROMPT_DIR=prompts/
AUTODOC_DIR=.
LOG_DIR=backend/logs/

# --- Misc ---
# DEVOPS_RELAX_TOOLCHECK=1  (Windows: skip gcc/cmake/etc checks)
# OLLAMA_BASE_URL=http://localhost:11434

# --- 45차 C1: JWT 인증 (필수 — 프로덕션) ---
# JWT_SECRET — 32바이트 이상 random string. openssl rand -base64 32로 생성 권장.
# 미설정 시 dev fallback (재기동 시 모든 토큰 무효).
# JWT_SECRET=

# JWT_ALGORITHM — HS256 기본. internal network 환경. 외부 노출 시 RS256 + 키 분리 검토.
# JWT_ALGORITHM=HS256

# Token expire (사용자 결정: Access 60분 + Refresh 7일)
# JWT_ACCESS_EXPIRE_MINUTES=60
# JWT_REFRESH_EXPIRE_DAYS=7

# DEV_MODE_X_USER_FALLBACK — 1이면 JWT 없을 때 X-User 헤더 fallback 허용.
#
# ⚠ **1로 두면 인증이 사실상 없다.** 실측(2026-08-04): `X-User: <admin_users.json 의 이름>`
#    헤더 한 줄로 admin 라우트 27개가 통과했고, 그중에는 `/api/swut/sutr/build` 같은
#    ISO 26262 evidence 생성기가 있다 — `backend/dependencies/admin.py:6` 이 스스로
#    "admin만 evidence 생성 가능" 이라 적어둔 불변식이 헤더 하나로 무너진다.
#    게다가 X-User 경로는 `token_version` 검사를 안 타므로 **누가 만든 evidence 인지
#    사후 판별이 안 되고 로그아웃·계정삭제로 취소도 안 된다**.
#    `/api/auth/me` 가 admin 계정명 oracle 이 되는 것도 이 플래그 때문이다.
#
# ⚠ 주석 처리하지 말고 **값을 명시**한다. 주석이면 파일만 봐서는 무엇이 적용 중인지
#    알 수 없고, 실제로 이 저장소의 `.env` 에 `=1` 이 덧붙어 오래 남아 있었다.
#    끄면 깨지는 것은 실측 0건이다 — 프론트는 AuthGate 로 항상 JWT 를 갖고,
#    백엔드 테스트는 conftest 가 자체 setenv 한다.
DEV_MODE_X_USER_FALLBACK=0

# --- 45차 C1: 첫 admin 사용자 자동 등록 (옵션) ---
# 빈 config/users.json + 두 env 모두 설정 시 startup 시 자동 등록.
# must_change_password=true로 첫 로그인 후 PW 변경 강제.
# BOOTSTRAP_ADMIN_USER=hbrnd2
# BOOTSTRAP_ADMIN_PASSWORD=changeme_at_first_login_8plus

# --- 41차 W2: admin role 자동 등록 (옵션) ---
# 콤마 list. 빈 config/admin_users.json에 자동 등록 (lockout 회복).
# BOOTSTRAP_ADMIN_USERS=hbrnd2
