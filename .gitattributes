# Default: text auto-detection, normalize LF on commit
* text=auto

# Shell scripts and git hooks must keep LF on all platforms — bash on Windows
# (msys2 / git-bash) refuses to execute scripts with CRLF line endings.
*.sh        text eol=lf
.githooks/* text eol=lf

# This file itself must be LF — git reads it before applying eol=lf to others.
.gitattributes text eol=lf

# Python: keep LF for cross-platform consistency (PEP 8, ruff/black expectation)
*.py text eol=lf

# Frontend source: LF (vite, eslint default)
*.js  text eol=lf
*.jsx text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md  text eol=lf

# Config / IaC files (workflows, Dockerfile, etc.)
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
Dockerfile*    text eol=lf
.dockerignore  text eol=lf
.gitignore     text eol=lf

# Test / data fixtures
*.csv text
*.tsv text

# Windows scripts must keep CRLF — cmd.exe and some PowerShell hosts
# choke on LF-only line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.docx binary
*.xlsx binary
*.pdf  binary
*.zip  binary
